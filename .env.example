# =================================================================
# ForgeSwarm Configuration
# =================================================================

# Server
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO

# Frontend
VITE_API_URL=http://localhost:8000

# Database
DATABASE_URL=sqlite:///./forgeswarm.db
# Primary PostgreSQL example:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/forgeswarm

# LLM Providers (Optional for Real AI Mode, MockProvider runs deterministically when absent)
GEMINI_API_KEY=
OPENAI_API_KEY=
DEFAULT_LLM_PROVIDER=mock  # "mock" | "gemini" | "openai"
DEFAULT_MODEL=gemini-2.5-flash

# Execution & Workspace
WORKSPACE_ROOT=./generated_projects
ENABLE_DOCKER=false
DOCKER_REGISTRY=local
